# OpenRouter API Key (Recomendado: acceso multimodelo y económico)
# Obtén tu clave en: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Modelos especializados por rol de agente (OpenRouter)
MODEL_REPO_ANALYZER=qwen/qwen-2.5-coder-32b-instruct
MODEL_CV_WRITER=deepseek/deepseek-chat
MODEL_EVALUATOR=deepseek/deepseek-r1

# Google Gemini API Key (Opcional, si usas la API directa de Google)
# Obtén tu clave en: https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash

# GitHub Personal Access Token (Opcional, para repos privados o evitar límites de rate de la API pública)
# GITHUB_TOKEN=your_github_token_here
