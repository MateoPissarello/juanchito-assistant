# Google Gemini API Key (Requerido para los agentes y análisis con IA)
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo de Gemini a utilizar (opcional, por defecto gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# GitHub Personal Access Token (Opcional, para repos privados o evitar límites de rate de la API pública)
# GITHUB_TOKEN=your_github_token_here
